<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage</title>
  </head>
  <body>
    <a href="/new">Create Message</a>
    <ul>
      <% for (let i = 0; i < messages.length; i++) { %>
        <li>
          <h2>Username: <%= messages[i].user %></h2>
          <p>Message text: <%= messages[i].text %></p>
          <p>Send time msg: <%= messages[i].added %></p>
          <a href='msg/<%=[i]%>'>Open message</a>
        </li>    
      <% } %>
   </ul>
  </body>
</html>