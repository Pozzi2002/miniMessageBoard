<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage</title>
  </head>
  <body>
    <ul>
    <% messages.forEach((message) => { %>
      <li>
        <h2>Username: <%= message.user %></h2>
        <p>Message text: <%= message.text %></p>
        <p>Send time msg: <%= message.added %></p>
      </li>    
    <% }) %>
    </ul>
  </body>
</html>